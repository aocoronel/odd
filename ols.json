{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"collections": [
		{ "name": "odd", "path": "odd" }
	],
  "enable_format": false,
  "enable_hover": true,
  "enable_hover_layout": true,
  "enable_document_symbols": true,
  "enable_fake_methods": true,
  "enable_overload_resolution": true,
  "enable_references": true,
  "enable_document_highlights": false,
  "enable_document_links": false,
  "enable_completions": true,
  "enable_completion_matching": false,
  "enable_unused_imports_reporting": false,
  "enable_unused_imports_on_change": false,
  "enable_inlay_hints_params": false,
  "enable_inlay_hints_default_params": false,
  "enable_inlay_hints_implicit_return": false,
  "enable_inlay_hints_optional_result": false,
  "enable_semantic_tokens": false,
  "enable_snippets": true,
  "enable_procedure_snippet": false,
  "enable_checker_only_saved": false,
  "enable_compiler_semantics": false,
  "enable_checker_on_change": false,
  "checker_on_change_delay": 99999,
  "enable_fade_untaken_when_branches": false,
  "enable_checker_workspace_diagnostics": false,
  "enable_auto_import": true,
  "enable_auto_import_skip_hidden_paths": true,
  "enable_comp_lit_signature_help": true,
  "enable_comp_lit_signature_help_use_docs": true,
  "enable_code_action_invert_if": false,
  "struct_fields_underscore_visibility": "",
  "enable_parser_errors": false,
  "enable_diagnostics": false,
  "completion_exclude_attributes": ["@test"],
  "verbose": false
}
