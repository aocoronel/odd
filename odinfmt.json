{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/odinfmt.schema.json",
  "character_width": 100,
  "newline_limit": 1,
  "tabs": true,
  "tabs_width": 4,
  "convert_do": false,
  "brace_style": "Stroustrop",
  "indent_cases": false,
  "newline_style": "LF",
  "sort_imports": true,
  "inline_single_stmt_case": true,
  "spaces_around_colons": false,
  "space_single_line_blocks": true,
  "align_struct_fields": true,
  "align_struct_values": true,
  "align_comments": true,
  "multiline_composite_literals": true,
  "preserve_struct_blank_lines": true
}
